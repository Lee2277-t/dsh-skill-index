{
    "name":  "dsh-skill-index",
    "version":  "1.6.3",
    "description":  "Search a local agent-skill library with CJK-aware, IDF-weighted matching and a bilingual glossary; read a skill as a digest or in full; hint the likely skill at the start of each turn; keep a per-session ledger. Ships an evaluation harness.",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "keywords":  [
                     "dsh-plugin",
                     "skills",
                     "search",
                     "agent"
                 ],
    "license":  "AGPL-3.0-only",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Lee2277-t/dsh-skill-index.git"
                   },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "\u003e=0.1.0-rc.7"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            }
                             }
}